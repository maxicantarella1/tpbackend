# ==============================================================================
# Ejemplo de variables de entorno para Docker Compose (.env)
# Copiar como ".env" si se desean personalizar credenciales en producción/local.
# Si no se crea ".env", docker-compose.yml utiliza estos valores por defecto.
# ==============================================================================

POSTGRES_USER=turismo
POSTGRES_PASSWORD=turismo

KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

KEYCLOAK_CLIENT_SECRET=reservas-secret
