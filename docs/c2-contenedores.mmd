    end

    lib{{"common-lib.jar<br/>(dependencia Maven en ~/.m2,<br/>no corre como contenedor)"}}

    cli -- "1 · pide token (OIDC)" --> kc
    cli -- "2 · HTTPS/JSON + Bearer JWT" --> gw
