flowchart LR
    cli(["Turista / Administrador<br/>cliente HTTP"])
    om[["Open-Meteo<br/>API pública de pronóstico<br/>(fuera del despliegue)"]]

    subgraph docker["docker-compose · red interna 'turismo' (zona de confianza)"]
        direction LR
        gw["API Gateway :8080<br/>Spring Cloud Gateway + Spring Security<br/>valida JWT · roles · rutea · Swagger UI"]
        kc["Keycloak :8180<br/>IdP OIDC · roles ADMIN / USUARIO"]
        act["Servicio de Actividades :8081<br/>Spring Boot 3.2<br/>proveedores · actividades · salidas · cupo"]
        res["Servicio de Reservas :8082<br/>Spring Boot 3.2<br/>reglas · clima · modificar · reevaluar"]
