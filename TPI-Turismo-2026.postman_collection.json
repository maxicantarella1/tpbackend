    {
      "name": "3. Flujo Central del MVP: Creacion de Reservas (NEG-01)",
      "description": "Demuestra el proceso de negocio central atravesando API Gateway -> Reservas -> APIs Externas -> Keycloak (Client Credentials) -> Actividades.",
      "item": [
        {
          "name": "3.1 [Turista 1] Reservar Actividad 1 (Aire Libre) en fecha cercana -> Evalua Clima en Vivo (201 o 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var code = pm.response.code;",
                  "var json = pm.response.json();",
                  "pm.test('Evaluacion climatica en vivo correcta (201 CONFIRMADA si buen clima / 409 Clima desfavorable si lluvia > 40%)', function () {",
                  "    pm.expect([201, 409]).to.include(code);",
                  "    if (code === 201) {",
                  "        pm.expect(json.estado).to.eql('CONFIRMADA');",
                  "        pm.expect(json.usuario).to.eql('turista1');",
                  "    } else {",
                  "        pm.expect(json.status).to.eql(409);",
                  "        pm.expect(json.error).to.eql('Clima desfavorable');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [ { "key": "token", "value": "{{tokenTurista1}}", "type": "string" } ]
            },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actividadId\": 1,\n  \"fecha\": \"{{fechaCercana}}\",\n  \"cantidadPersonas\": 2,\n  \"edadMenor\": 22,\n  \"adultos\": 2\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/reservas",
              "host": [ "{{gatewayUrl}}" ],
              "path": [ "reservas" ]
            }
          },
          "response": []
        },
        {
